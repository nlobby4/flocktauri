{
  "manifest_version": 3,
  "name": "Flockmod Extension",
  "version": "1.4.0",
  "description": "Combines flockmod.js replacement and mod injection",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://flockmod.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://flockmod.com/draw/*",
        "https://flockmod.com/r/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "flockmod.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "flockmod.js",
        "injected.js",
        "homography.js"
      ],
      "matches": [
        "https://flockmod.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "flockmod-mod@example.com",
      "strict_min_version": "109.0"
    }
  }
}
